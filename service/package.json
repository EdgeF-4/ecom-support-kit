{
  "name": "ecom-support-kit-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic tool service for the support kit: order lookup, FAQ retrieval, escalation, and booking on mock adapters.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "npm run build && node dist/src/demo.js",
    "verify": "npm test && node dist/src/demo.js"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "typescript": "5.9.3"
  }
}
