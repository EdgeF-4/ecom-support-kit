{
  "name": "Support Intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support/intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "id": "intake-webhook",
      "name": "Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "webhookId": "support-intake"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPPORT_SERVICE_URL}}/support",
        "sendBody": true,
        "contentType": "json",
