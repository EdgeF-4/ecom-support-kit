        "jsonBody": "={{ JSON.stringify({ message: $json.body.message, email: $json.body.email, channel: $json.body.channel || \"web\" }) }}",
        "options": {}
      },
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "id": "process-support-request",
      "name": "Process Support Request",
      "type": "n8n-nodes-base.httpRequest"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: $json.reply, intent: $json.intent, route: $json.route, status: $json.status, ticketId: $json.ticketId, cached: $json.cached }) }}",
        "options": {}
      },
      "typeVersion": 1.1,
      "position": [
        940,
        300
      ],
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook"
    }
  ],
  "connections": {
    "Intake Webhook": {
      "main": [
        [
          {
            "node": "Process Support Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Support Request": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
